# =================================================================
# SKILLFORGE AI BACKEND ENVIRONMENT CONFIGURATION (.env)
# =================================================================

# 1. Database Connection URL (Paste your Neon Postgres / Railway / Supabase connection string here)
# Example: postgresql://username:password@ep-cool-db-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./skillforge.db

# 2. Secret Key for JWT Auth Token Generation
SECRET_KEY=skillforge-ai-hack-orbit-2026-secret-key

# 3. Optional OpenAI API Key for Live LLM Extraction & Dynamic Roadmaps
# If left blank, backend operates with structured AI cartography fallbacks cleanly
OPENAI_API_KEY=
