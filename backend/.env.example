# ---------------------------------------------------------------------------
# SkillForge AI backend — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Database (NeonDB / PostgreSQL) -----------------------------------------
# Get this from your Neon project dashboard -> Connection Details.
# Use your own dev branch while developing, e.g. dev-member1, so you never
# touch teammates' data or the shared `main` demo database.
# Format: postgresql+psycopg2://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL=postgresql+psycopg2://user:password@ep-example-12345.us-east-2.aws.neon.tech/skillforge?sslmode=require

# --- AI provider --------------------------------------------------------------
# Powers resume extraction + roadmap generation. Never expose this key to the
# frontend — every LLM call happens behind app/services/llm_client.py.
# Two providers are supported; set AI_PROVIDER to pick one:
#   gemini    -> Google Gemini. Get a free API key at https://aistudio.google.com/apikey
#                AI_MODEL=gemini-3.6-flash (or gemini-3.5-flash-lite for lower cost)
#   anthropic -> Claude. Get a key at https://console.anthropic.com/settings/keys
#                (requires a funded billing account — no free tier)
#                AI_MODEL=claude-sonnet-4-5-20250929
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.6-flash

# --- Auth ---------------------------------------------------------------------
# Real auth (Module A) is owned by Member 2. Until it lands, the backend uses
# a lightweight dev-auth stub (see app/dependencies.py) gated by this flag.
JWT_SECRET=change-me-in-production
AUTH_DEV_MODE=true
DEV_USER_EMAIL=dev@skillforge.local

# --- App ------------------------------------------------------------------
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173
MAX_RESUME_FILE_SIZE_MB=8
LOG_LEVEL=INFO
