# =============================================================================
# SkillForge AI — ROOT frontend environment template
# =============================================================================
# This is the "flashy" Blueprint Cartography app (the one `npm run dev` runs
# from THIS folder). It talks to the FastAPI backend in backend/ over HTTP —
# it has no server-side secrets of its own, so this file only needs one var.
#
# Copy this file to `.env` in this same folder and fill in the real value.
# Never commit `.env` (it's already in .gitignore).
#
# All backend secrets (DATABASE_URL, JWT_SECRET, AI_API_KEY, etc.) live in
# backend/.env — see backend/.env.example for that template. They do NOT
# belong here; this file previously mixed the two together, which is exactly
# the kind of ambiguity this cleanup removes.

# Base URL of the SkillForge AI FastAPI backend.
#   Local dev:   http://localhost:8000
#   Production:  your deployed Render backend URL, e.g.
#                https://skillforge-backend.onrender.com
VITE_API_BASE_URL=http://localhost:8000
