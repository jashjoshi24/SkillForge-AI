# ==========================================
# SkillForge AI Environment Configuration
# ==========================================

# 1. Database Connection (Neon Postgres or SQLite)
# For local SQLite fallback:
DATABASE_URL="sqlite:///./skillforge.db"

# For Neon PostgreSQL (Replace with your actual Neon Console connection string):
# DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. JWT Security Secret
SECRET_KEY="skillforge-secret-key-hackathon-2026-secure-jwt-seed"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 3. LLM API Keys (Optional - System uses intelligent fallback template engine if keys are blank)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
